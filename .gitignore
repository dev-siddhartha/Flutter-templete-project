# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Test coverage output (flutter test --coverage)
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release


#! Uncomment this line while developing project
# *.vscode/

# Environment files - copy .env.example to .env.dev / .env.prod and fill in real values.
.env.dev
.env.prod

# Firebase config - copy the matching *.example file and fill in real values
# (see: https://firebase.google.com/docs/flutter/setup#configure-firebase).
android/app/src/*/google-services.json
ios/config/*/GoogleService-Info.plist

# Android release signing - copy key.properties.example and fill in real values.
android/key.properties